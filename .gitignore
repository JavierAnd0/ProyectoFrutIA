.env
.venv/
__pycache__/
.pytest_cache/

# Datos en ejecución
data/
mosquitto/data/
mosquitto/config/passwd
ollama/

# Home Assistant: solo se versiona la configuración escrita a mano
homeassistant/*
!homeassistant/configuration.yaml
!homeassistant/automations.yaml
!homeassistant/custom_sentences/
!homeassistant/dashboards/

.DS_Store
~$*.docx

# Firmware: credenciales locales
firmware/**/secrets.h

# Fotos del dataset (se suben a Edge Impulse, no a git)
dataset/

# Zip del dataset para pasarlo entre equipos (no va a git, igual que dataset/)
fruits360_muestra.zip

# Capturas del ESP32 virtual (tecla g) para revisar fallos del modelo
capturas/
errores.jpg
