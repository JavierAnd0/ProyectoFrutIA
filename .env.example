# Copiar a .env y cambiar las claves. .env NO se sube a Git.
TZ=America/Bogota
FRUTAS=manzana,pera,banano,kiwi

# Un usuario MQTT por cliente (así en los logs se ve quién publicó qué).
MQTT_USUARIO_SERVICIO=servicio
MQTT_CLAVE_SERVICIO=cambiar
MQTT_USUARIO_HA=homeassistant
MQTT_CLAVE_HA=cambiar
MQTT_USUARIO_ESP32=esp32
MQTT_CLAVE_ESP32=cambiar
